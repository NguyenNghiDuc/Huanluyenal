ANTHROPIC_API_KEY=
PORT=3001
WEB_ORIGIN=http://localhost:5173
# Optional: enables web_search using Brave Search
BRAVE_SEARCH_API_KEY=
# Optional overrides (default: localhost only, SQLite in ../data/)
HOST=127.0.0.1
# DB_PATH=/absolute/path/to/al.sqlite

# Optional external delivery. Nothing is sent until reviewed on the web.
# Must be HTTPS. This URL and token never go to the frontend.
EXTERNAL_WEBHOOK_URL=
EXTERNAL_WEBHOOK_LABEL=Hộp nhận của tôi
EXTERNAL_WEBHOOK_TOKEN=
